{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edge-field-assistant",
  "main": "src/worker.ts",
  "compatibility_date": "2025-05-01",
  "assets": {
    "directory": "./demo-app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "SCHEMAS_DB",
      "database_name": "edge-field-assistant-schemas",
      "database_id": "25ec2486-d12e-4e11-80c4-408038f37e27"
    }
  ]
}
